# Gateway webhook endpoints.
# Only the four handlers may be requested; the shared bootstrap stays private.

<FilesMatch "^_">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Webhooks are POST-only, server-to-server. No directory listing, no rewriting.
Options -Indexes
<IfModule mod_rewrite.c>
    RewriteEngine Off
</IfModule>
